{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rusi",
  "version": "0.1.0",
  "identifier": "dev.rusi.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [{ "title": "Rusi", "width": 1280, "height": 800, "minWidth": 900, "minHeight": 560 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": true, "targets": ["deb", "appimage"], "icon": ["icons/icon.png"] }
}
